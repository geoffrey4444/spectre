@@ -0,0 +1,27 @@
+cmake_minimum_required(VERSION 3.16)
+project(BroadcastCleanupRegression LANGUAGES CXX)
+enable_testing()
+
+# Test the actual private queue implementation without starting a Charm runtime.
+# Message allocation and PUP are stubbed in the driver; insertion and cleanup are
+# extracted byte-for-byte from the production header.
+file(READ "${CMAKE_CURRENT_SOURCE_DIR}/../../../src/ck-core/ckarray.h" array_header)
+string(FIND "${array_header}" "  class BcastQueue\n" queue_start)
+string(FIND "${array_header}" "\n  int bcastSendEpoch" queue_end)
+if(queue_start LESS 0 OR queue_end LESS queue_start)
+  message(FATAL_ERROR "Could not locate BcastQueue in ckarray.h")
+endif()
+math(EXPR queue_length "${queue_end} - ${queue_start}")
+string(SUBSTRING "${array_header}" ${queue_start} ${queue_length} queue_source)
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/queue.hpp" "${queue_source}")
+
+add_executable(broadcast_cleanup_test test_queue.cpp)
+target_compile_features(broadcast_cleanup_test PRIVATE cxx_std_17)
+target_compile_definitions(broadcast_cleanup_test PRIVATE
+  QUEUE_HEADER="${CMAKE_CURRENT_BINARY_DIR}/queue.hpp")
+foreach(case ordered late random)
+  add_test(NAME broadcast_cleanup_${case} COMMAND broadcast_cleanup_test ${case})
+  set_tests_properties(broadcast_cleanup_${case} PROPERTIES TIMEOUT 5)
+endforeach()
+add_test(NAME broadcast_cleanup_stale COMMAND broadcast_cleanup_test stale)
+set_tests_properties(broadcast_cleanup_stale PROPERTIES WILL_FAIL TRUE TIMEOUT 5)
